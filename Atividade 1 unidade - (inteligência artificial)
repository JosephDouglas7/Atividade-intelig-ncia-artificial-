#método IQR(Intervalo Interquartil)
# Exemplo de criação de DataFrame (substitua pelos seus dados reais)
# weight_kg = peso dos pacientes
df_limpo = pd.read_csv("stroke_risk_prediction_dataset.csv")

# Cálculo dos quartis e IQR
Q1 = df_limpo["Weight_kg"].quantile(0.25)
Q3 = df_limpo["Weight_kg"].quantile(0.75)
IQR = Q3 - Q1

# Definição dos limites
limite_inferior = Q1 - 1.5 * IQR
limite_superior = Q3 + 1.5 * IQR

# Identificação dos outliers
outliers_iqr = df_limpo[(df_limpo["Weight_kg"] < limite_inferior) | (df_limpo["Weight_kg"] > limite_superior)]

# Impressão dos resultados
print(f"Q1 = {Q1} | Q3 = {Q3} | IQR = {IQR}")
print(f"Limite inferior: {limite_inferior:.2f} | Limite superior: {limite_superior:.2f}")
print(f"Número de outliers detectados (IQR): {len(outliers_iqr)}")

#método z-score


df_limpo = pd.read_csv("stroke_risk_prediction_dataset.csv")
# Cálculo do Z-score
df_limpo["zscore_Weight_kg"] = np.abs(stats.zscore(df_limpo["Weight_kg"]))

# Filtragem dos outliers
