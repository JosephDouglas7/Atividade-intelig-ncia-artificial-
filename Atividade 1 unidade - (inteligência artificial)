#Calcular um conjunto completo de medidas estatísticas, para compreensão melhor
#da distribuição das variáveis numéricas.
# height_cm = altura dos pacientes
def resumo_estatistico(serie):
    return pd.Series({
        "média": serie.mean(),
        "mediana": serie.median(),
        "desvio_padrão": serie.std(),
        "variância": serie.var(),
        "Q1": serie.quantile(0.25),
        "Q3": serie.quantile(0.75),
        "assimetria": serie.skew(),
        "curtose": serie.kurtosis(),
    })

resumo_estatistico(df_limpo["Height_cm"]).round(3) 

#Resumo_estatistico do Calculo de um conjunto completo de medidas estatísticas
